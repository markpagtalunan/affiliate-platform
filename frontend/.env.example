# Demo mode is ON by default (no backend, no Firebase needed). Set to "false" for real mode.
VITE_USE_MOCK=true

# --- Real mode only (VITE_USE_MOCK=false) ---
# Backend base URL including /api/v1
VITE_API_URL=http://localhost:8080/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Public B2C site used to build referral links (used in both modes)
VITE_B2C_URL=https://lakbayhub.example.com
