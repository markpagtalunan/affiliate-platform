PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Comma list also allowed, e.g. https://portal.example.com,https://www.example.com (include the B2C site: it calls /track/click)
ADMIN_EMAILS=admin@example.com

# memory = in-memory store (tests / local). firestore = production.
DATA_STORE=memory
# firebase = verify Firebase ID tokens. dev = accept "Bearer dev:<email>:<name>" (refused when NODE_ENV=production)
AUTH_MODE=dev

# Firebase Admin (DATA_STORE=firestore or AUTH_MODE=firebase). Use ONE of:
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=
# (or leave both empty on GCP to use Application Default Credentials)

# Valkey/Redis (optional; cache + click rate limit). Empty = disabled.
VALKEY_URL=

# SES (optional; empty SES_FROM = emails are only logged)
AWS_REGION=ap-southeast-1
SES_FROM=

# LakbayHub holiday API
HOLIDAY_API_URL=
HOLIDAY_API_KEY=
MOCK_PACKAGES=true

BOOKING_WEBHOOK_SECRET=change-me

# Optional
TRUST_PROXY=
TZ_OFFSET_MINUTES=480
IP_HASH_SALT=
FIRESTORE_DATABASE_ID=
